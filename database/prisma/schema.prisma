generator client {
  provider = "prisma-client-js"
}

generator backendClient {
  provider = "prisma-client-js"
  output   = "../../apps/backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum PartnerType {
  SUPPLIER
  DISTRIBUTOR
  DEALER
  DIRECT_DEALER
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleType {
  SUPPLIER
  DISTRIBUTOR
  DEALER
  DIRECT_DEALER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum InventoryStatus {
  ACTIVE
  OUT_OF_STOCK
  LOW_STOCK
}

enum InventoryItemStatus {
  AVAILABLE
  ALLOCATED
  IN_TRANSIT
  SOLD
  RETURNED
  DAMAGED
  REPAIR
  REPLACED
}

enum StockMovementType {
  INBOUND
  OUTBOUND
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum OrderStatus {
  DRAFT
  PLACED
  SUBMITTED
  APPROVED
  PROCESSING
  DISPATCHED
  DELIVERED
  INVOICED
  COMPLETED
  CANCELLED
  REJECTED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  ONLINE
  CREDIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LedgerTransactionType {
  DEBIT
  CREDIT
}

enum LedgerReferenceType {
  INVOICE
  PAYMENT
  CREDIT_NOTE
  ADJUSTMENT
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  CANCELLED
}

enum LeadSource {
  WALK_IN
  PHONE
  WHATSAPP
  WEBSITE
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  QUOTED
  CONVERTED
  LOST
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOIDED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ServiceTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum RMAType {
  REPAIR
  REPLACEMENT
  REFUND
}

enum RMAStatus {
  REQUESTED
  APPROVED
  RECEIVED
  PROCESSED
  REJECTED
}

enum ReportFormat {
  PDF
  CSV
  XLSX
  JSON
}

enum ReportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RecommendationEntityType {
  PRODUCT
  CUSTOMER
  PARTNER
  INVENTORY
}

enum RecommendationType {
  STOCK_REORDER
  UPSELL
  CHURN_RISK
  PRICING
}

enum RecommendationStatus {
  PENDING
  APPLIED
  DISMISSED
}

// ==========================================
// 1. IDENTITY DOMAIN
// ==========================================

model Role {
  id          String           @id @default(uuid())
  name        RoleType         @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  id            String   @id @default(uuid())
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource      String
  action        String
  permissionKey String   @unique
  createdAt     DateTime @default(now())

  @@index([roleId])
}

model User {
  id                     String                 @id @default(uuid())
  email                  String                 @unique
  passwordHash           String
  name                   String
  roleId                 String
  role                   Role                   @relation(fields: [roleId], references: [id])
  partnerId              String?
  partner                Partner?               @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  status                 UserStatus             @default(ACTIVE)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  auditLogs              AuditLog[]
  performedMovements     StockMovement[]
  assignedLeads          Lead[]
  performedFollowUps     FollowUp[]
  assignedTickets        ServiceTicket[]
  generatedReports       Report[]
  notifications          Notification[]
  requestedTransfers     StockTransferRequest[] @relation("RequestedTransfers")
  approvedTransfers      StockTransferRequest[] @relation("ApprovedTransfers")
  requestedReturns       StockReturnRequest[]   @relation("RequestedReturns")
  approvedReturns        StockReturnRequest[]   @relation("ApprovedReturns")
  approvedPurchaseOrders PurchaseOrder[]        @relation("POApprovedBy")

  @@index([partnerId])
  @@index([roleId])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role          String?
  partnerId     String?
  partner       Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  action        String
  entity        String
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  timestamp     DateTime @default(now())

  @@index([userId])
  @@index([partnerId])
  @@index([timestamp])
}

// ==========================================
// 2. PARTNER / CUSTOMER DOMAIN
// ==========================================

model Partner {
  id              String        @id @default(uuid())
  name            String
  type            PartnerType
  parentPartnerId String?
  parentPartner   Partner?      @relation("PartnerHierarchy", fields: [parentPartnerId], references: [id], onDelete: Restrict)
  childPartners   Partner[]     @relation("PartnerHierarchy")
  territory       String?
  address         String?
  phone           String?
  email           String?
  creditLimit     Decimal       @default(0.00) @db.Decimal(12, 2)
  status          PartnerStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users                         User[]
  auditLogs                     AuditLog[]
  customers                     Customer[]
  warehouses                    Warehouse[]
  inventories                   Inventory[]
  inventoryItems                InventoryItem[]
  purchaseAsBuyer               PurchaseOrder[]        @relation("POBuyer")
  purchaseAsSeller              PurchaseOrder[]        @relation("POSeller")
  salesAsBuyer                  SalesOrder[]           @relation("SOBuyer")
  salesAsSeller                 SalesOrder[]           @relation("SOSeller")
  invoicesAsSeller              Invoice[]              @relation("InvoiceSeller")
  invoicesAsBuyer               Invoice[]              @relation("InvoiceBuyer")
  payments                      Payment[]
  ledgers                       Ledger[]
  creditNotes                   CreditNote[]
  leads                         Lead[]
  quotations                    Quotation[]
  rmas                          RMA[]
  fromMovements                 StockMovement[]        @relation("FromPartnerMovements")
  toMovements                   StockMovement[]        @relation("ToPartnerMovements")
  sourcePartnerTransferRequests StockTransferRequest[] @relation("SourcePartnerTransferRequests")
  destPartnerTransferRequests   StockTransferRequest[] @relation("DestPartnerTransferRequests")
  sourcePartnerReturnRequests   StockReturnRequest[]   @relation("SourcePartnerReturnRequests")
  destPartnerReturnRequests     StockReturnRequest[]   @relation("DestPartnerReturnRequests")

  @@index([parentPartnerId])
}

model Customer {
  id        String         @id @default(uuid())
  partnerId String
  partner   Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  address   String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  inventoryItems InventoryItem[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  payments       Payment[]
  creditNotes    CreditNote[]
  leads          Lead[]
  quotations     Quotation[]
  warranties     Warranty[]
  serviceTickets ServiceTicket[]
  rmas           RMA[]

  @@index([partnerId])
}

// ==========================================
// 3. CATALOG DOMAIN
// ==========================================

model Category {
  id               String         @id @default(uuid())
  name             String
  parentCategoryId String?
  parentCategory   Category?      @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories    Category[]     @relation("CategoryHierarchy")
  description      String?
  status           CategoryStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  products Product[]

  @@index([parentCategoryId])
}

model Product {
  id                   String        @id @default(uuid())
  SKU                  String        @unique
  name                 String
  brand                String
  categoryId           String
  category             Category      @relation(fields: [categoryId], references: [id])
  model                String?
  description          String?
  MRP                  Decimal       @db.Decimal(12, 2)
  supplierPrice        Decimal       @db.Decimal(12, 2)
  distributorPrice     Decimal       @db.Decimal(12, 2)
  dealerPrice          Decimal       @db.Decimal(12, 2)
  directDealerPrice    Decimal       @db.Decimal(12, 2)
  tax                  Decimal       @default(0.00) @db.Decimal(5, 2)
  warrantyPeriod       Int           @default(12) // Months
  IMEITracked          Boolean       @default(true)
  lowStockThreshold    Int           @default(10)
  minimumOrderQuantity Int           @default(1)
  status               ProductStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  inventories      Inventory[]
  inventoryItems   InventoryItem[]
  poLines          PurchaseOrderLine[]
  soLines          SalesOrderLine[]
  invoiceLines     InvoiceLine[]
  stockMovements   StockMovement[]
  warranties       Warranty[]
  serviceTickets   ServiceTicket[]
  rmas             RMA[]
  pricings         ProductPricing[]
  transferRequests StockTransferRequest[]
  returnRequests   StockReturnRequest[]

  @@index([SKU])
}

model ProductPricing {
  id          String      @id @default(uuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  partnerType PartnerType
  price       Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([productId, partnerType])
  @@index([productId])
}

// ==========================================
// 4. INVENTORY DOMAIN
// ==========================================

model Warehouse {
  id        String          @id @default(uuid())
  partnerId String
  partner   Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  location  String?
  code      String          @unique
  status    WarehouseStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  inventories            Inventory[]
  items                  InventoryItem[]
  fromMovements          StockMovement[]        @relation("FromWarehouseMovements")
  toMovements            StockMovement[]        @relation("ToWarehouseMovements")
  sourceTransferRequests StockTransferRequest[] @relation("SourceTransferRequests")
  destTransferRequests   StockTransferRequest[] @relation("DestTransferRequests")
  sourceReturnRequests   StockReturnRequest[]   @relation("SourceReturnRequests")
  destReturnRequests     StockReturnRequest[]   @relation("DestReturnRequests")
  sourcePurchaseOrders   PurchaseOrder[]        @relation("POSourceWarehouse")
  destPurchaseOrders     PurchaseOrder[]        @relation("PODestinationWarehouse")

  @@index([partnerId])
}

model Inventory {
  id               String          @id @default(uuid())
  partnerId        String
  partner          Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  quantity         Int             @default(0)
  reservedQuantity Int             @default(0)
  status           InventoryStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items InventoryItem[]

  @@unique([warehouseId, productId])
  @@index([partnerId])
  @@index([productId])
}

model InventoryItem {
  id           String              @id @default(uuid())
  inventoryId  String
  inventory    Inventory           @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productId    String
  product      Product             @relation(fields: [productId], references: [id])
  IMEI         String              @unique
  serialNumber String
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  partnerId    String
  partner      Partner             @relation(fields: [partnerId], references: [id])
  status       InventoryItemStatus @default(AVAILABLE)
  purchaseDate DateTime?
  saleDate     DateTime?
  customerId   String?
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  stockMovements  StockMovement[]
  salesOrderLines SalesOrderLine[]
  warranties      Warranty[]
  serviceTickets  ServiceTicket[]
  rmas            RMA[]

  @@index([IMEI])
  @@index([serialNumber])
  @@index([warehouseId])
  @@index([partnerId])
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

model StockMovement {
  id                  String             @id @default(uuid())
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  inventoryItemId     String?
  inventoryItem       InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  fromWarehouseId     String?
  fromWarehouse       Warehouse?         @relation("FromWarehouseMovements", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouseId       String?
  toWarehouse         Warehouse?         @relation("ToWarehouseMovements", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  fromPartnerId       String?
  fromPartner         Partner?           @relation("FromPartnerMovements", fields: [fromPartnerId], references: [id], onDelete: SetNull)
  toPartnerId         String?
  toPartner           Partner?           @relation("ToPartnerMovements", fields: [toPartnerId], references: [id], onDelete: SetNull)
  movementType        StockMovementType
  quantity            Int
  referenceNumber     String?
  performedByUserId   String?
  performedByUser     User?              @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)
  purchaseOrderId     String?
  purchaseOrder       PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  salesOrderId        String?
  salesOrder          SalesOrder?        @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  salesOrderLineId    String?
  salesOrderLine      SalesOrderLine?    @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)
  timestamp           DateTime           @default(now())

  @@index([timestamp])
  @@index([productId])
  @@index([purchaseOrderId])
  @@index([purchaseOrderLineId])
}

model StockTransferRequest {
  id                     String         @id @default(uuid())
  productId              String
  product                Product        @relation(fields: [productId], references: [id])
  sourceWarehouseId      String
  sourceWarehouse        Warehouse      @relation("SourceTransferRequests", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId String
  destinationWarehouse   Warehouse      @relation("DestTransferRequests", fields: [destinationWarehouseId], references: [id])
  sourcePartnerId        String
  sourcePartner          Partner        @relation("SourcePartnerTransferRequests", fields: [sourcePartnerId], references: [id])
  destinationPartnerId   String
  destinationPartner     Partner        @relation("DestPartnerTransferRequests", fields: [destinationPartnerId], references: [id])
  quantity               Int
  imeis                  String[]       @default([])
  status                 TransferStatus @default(PENDING)
  requestedByUserId      String?
  requestedByUser        User?          @relation("RequestedTransfers", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId       String?
  approvedByUser         User?          @relation("ApprovedTransfers", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([status])
  @@index([sourcePartnerId])
  @@index([destinationPartnerId])
}

model StockReturnRequest {
  id                     String         @id @default(uuid())
  productId              String
  product                Product        @relation(fields: [productId], references: [id])
  sourceWarehouseId      String
  sourceWarehouse        Warehouse      @relation("SourceReturnRequests", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId String
  destinationWarehouse   Warehouse      @relation("DestReturnRequests", fields: [destinationWarehouseId], references: [id])
  sourcePartnerId        String
  sourcePartner          Partner        @relation("SourcePartnerReturnRequests", fields: [sourcePartnerId], references: [id])
  destinationPartnerId   String
  destinationPartner     Partner        @relation("DestPartnerReturnRequests", fields: [destinationPartnerId], references: [id])
  quantity               Int
  imeis                  String[]       @default([])
  reason                 String?
  status                 TransferStatus @default(PENDING)
  requestedByUserId      String?
  requestedByUser        User?          @relation("RequestedReturns", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId       String?
  approvedByUser         User?          @relation("ApprovedReturns", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([status])
  @@index([sourcePartnerId])
  @@index([destinationPartnerId])
}

// ==========================================
// 5. ORDERS DOMAIN
// ==========================================

model PurchaseOrder {
  id                     String      @id @default(uuid())
  orderNumber            String      @unique
  buyerPartnerId         String
  buyerPartner           Partner     @relation("POBuyer", fields: [buyerPartnerId], references: [id])
  sellerPartnerId        String
  sellerPartner          Partner     @relation("POSeller", fields: [sellerPartnerId], references: [id])
  sourceWarehouseId      String?
  sourceWarehouse        Warehouse?  @relation("POSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  destinationWarehouseId String?
  destinationWarehouse   Warehouse?  @relation("PODestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  status                 OrderStatus @default(DRAFT)
  totalAmount            Decimal     @default(0.00) @db.Decimal(12, 2)
  taxAmount              Decimal     @default(0.00) @db.Decimal(12, 2)
  requiresApproval       Boolean     @default(false)
  approvedByUserId       String?
  approvedByUser         User?       @relation("POApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt             DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  lines          PurchaseOrderLine[]
  invoices       Invoice[]
  stockMovements StockMovement[]

  @@index([status])
  @@index([buyerPartnerId])
  @@index([sellerPartnerId])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  tax             Decimal       @default(0.00) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)

  stockMovements StockMovement[]

  @@index([purchaseOrderId])
}

model SalesOrder {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  buyerPartnerId  String?
  buyerPartner    Partner?    @relation("SOBuyer", fields: [buyerPartnerId], references: [id], onDelete: SetNull)
  sellerPartnerId String
  sellerPartner   Partner     @relation("SOSeller", fields: [sellerPartnerId], references: [id])
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(DRAFT)
  totalAmount     Decimal     @default(0.00) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0.00) @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lines          SalesOrderLine[]
  invoices       Invoice[]
  stockMovements StockMovement[]

  @@index([status])
  @@index([sellerPartnerId])
}

model SalesOrderLine {
  id              String         @id @default(uuid())
  salesOrderId    String
  salesOrder      SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  quantity        Int
  unitPrice       Decimal        @db.Decimal(12, 2)
  tax             Decimal        @default(0.00) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)

  stockMovements StockMovement[]

  @@index([salesOrderId])
  @@index([inventoryItemId])
}

// ==========================================
// 6. FINANCE DOMAIN
// ==========================================

model Invoice {
  id              String         @id @default(uuid())
  invoiceNumber   String         @unique
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  salesOrderId    String?
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sellerPartnerId String
  sellerPartner   Partner        @relation("InvoiceSeller", fields: [sellerPartnerId], references: [id])
  buyerPartnerId  String?
  buyerPartner    Partner?       @relation("InvoiceBuyer", fields: [buyerPartnerId], references: [id], onDelete: SetNull)
  subtotal        Decimal        @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal        @db.Decimal(12, 2)
  taxAmount       Decimal        @default(0.00) @db.Decimal(12, 2)
  paidAmount      Decimal        @default(0.00) @db.Decimal(12, 2)
  status          InvoiceStatus  @default(UNPAID)
  dueDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines       InvoiceLine[]
  payments    Payment[]
  creditNotes CreditNote[]
  warranties  Warranty[]

  @@index([status])
  @@index([sellerPartnerId])
  @@index([buyerPartnerId])
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0.00) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0.00) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(uuid())
  paymentNumber   String        @unique
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  partnerId       String?
  partner         Partner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  status          PaymentStatus @default(COMPLETED)
  paymentDate     DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([invoiceId])
}

model Ledger {
  id              String                @id @default(uuid())
  partnerId       String
  partner         Partner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  transactionType LedgerTransactionType
  amount          Decimal               @db.Decimal(12, 2)
  balance         Decimal               @db.Decimal(12, 2)
  referenceType   LedgerReferenceType
  referenceId     String
  description     String?
  timestamp       DateTime              @default(now())

  @@index([partnerId])
  @@index([timestamp])
}

model CreditNote {
  id               String           @id @default(uuid())
  creditNoteNumber String           @unique
  invoiceId        String
  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  partnerId        String
  partner          Partner          @relation(fields: [partnerId], references: [id])
  customerId       String?
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount           Decimal          @db.Decimal(12, 2)
  reason           String?
  status           CreditNoteStatus @default(ISSUED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([invoiceId])
  @@index([partnerId])
}

// ==========================================
// 7. CRM DOMAIN
// ==========================================

model Lead {
  id             String     @id @default(uuid())
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  partnerId      String
  partner        Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  email          String?
  source         LeadSource @default(WALK_IN)
  status         LeadStatus @default(NEW)
  assignedUserId String?
  assignedUser   User?      @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  followUps  FollowUp[]
  quotations Quotation[]

  @@index([partnerId])
  @@index([status])
}

model FollowUp {
  statutoryId       String         @id @default(uuid())
  leadId            String
  lead              Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt       DateTime
  note              String?
  status            FollowUpStatus @default(PENDING)
  performedByUserId String?
  performedByUser   User?          @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())

  @@index([leadId])
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  partnerId       String
  partner         Partner         @relation(fields: [partnerId], references: [id])
  totalAmount     Decimal         @db.Decimal(12, 2)
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([partnerId])
}

// ==========================================
// 8. SERVICE DOMAIN
// ==========================================

model Warranty {
  id              String         @id @default(uuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  IMEI            String
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  startDate       DateTime
  endDate         DateTime
  status          WarrantyStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  serviceTickets ServiceTicket[]

  @@index([IMEI])
}

model ServiceTicket {
  id               String              @id @default(uuid())
  ticketNumber     String              @unique
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id])
  productId        String
  product          Product             @relation(fields: [productId], references: [id])
  warrantyId       String?
  warranty         Warranty?           @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  inventoryItemId  String?
  inventoryItem    InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  IMEI             String
  issueDescription String
  status           ServiceTicketStatus @default(OPEN)
  priority         Priority            @default(MEDIUM)
  assignedUserId   String?
  assignedUser     User?               @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  rmas RMA[]

  @@index([IMEI])
}

model RMA {
  id              String         @id @default(uuid())
  rmaNumber       String         @unique
  serviceTicketId String?
  serviceTicket   ServiceTicket? @relation(fields: [serviceTicketId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  partnerId       String
  partner         Partner        @relation(fields: [partnerId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  rmaType         RMAType
  status          RMAStatus      @default(REQUESTED)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([partnerId])
}

// ==========================================
// 9. SYSTEM DOMAIN
// ==========================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Report {
  id                String       @id @default(uuid())
  type              String
  generatedByUserId String?
  generatedByUser   User?        @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)
  format            ReportFormat @default(PDF)
  fileUrl           String?
  status            ReportStatus @default(PENDING)
  createdAt         DateTime     @default(now())
}

// ==========================================
// 10. AI DOMAIN
// ==========================================

model AIRecommendation {
  id                 String                   @id @default(uuid())
  entityType         RecommendationEntityType
  entityId           String
  recommendationType RecommendationType
  payload            Json
  confidenceScore    Float
  status             RecommendationStatus     @default(PENDING)
  createdAt          DateTime                 @default(now())

  @@index([entityId])
}
